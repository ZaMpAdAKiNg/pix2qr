{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build.sh",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Q+xsUuLeMTJCkWe8CE2hLDKrR03AuSgn2330SI5An04='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://cloud.umami.is https://gateway.umami.is https://api-gateway.umami.dev; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/licencas",
      "destination": "/licencas.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.pix2qr.xyz"
        }
      ],
      "destination": "https://pix2qr.xyz/$1",
      "permanent": true
    },
    {
      "source": "/PRIVACY.md",
      "destination": "/privacidade",
      "permanent": true
    },
    {
      "source": "/THIRD_PARTY.md",
      "destination": "/licencas",
      "permanent": true
    },
    {
      "source": "/SECURITY.md",
      "destination": "https://github.com/ZaMpAdAKiNg/pix2qr/blob/main/SECURITY.md",
      "permanent": true
    }
  ]
}
